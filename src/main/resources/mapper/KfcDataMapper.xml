<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="per.chowh.bot.plugins.kfc.mapper.KfcDataMapper">

    <resultMap id="BaseResultMap" type="per.chowh.bot.plugins.kfc.domain.KfcData">
            <id property="dataId" column="data_id" />
            <result property="kfcText" column="kfc_text" />
            <result property="createTime" column="create_time" />
            <result property="modifyTime" column="modify_time" />
            <result property="isDelete" column="is_delete" />
    </resultMap>

    <sql id="Base_Column_List">
        data_id,kfc_text,create_time,modify_time,is_delete
    </sql>

    <select id="selectRandom" resultMap="BaseResultMap" useCache="false" flushCache="true">
        select <include refid="Base_Column_List"/>
        from kfc_data
        where is_delete = 0
        order by random()
        limit 1
    </select>
</mapper>
