# 环境变量模板：复制为 .env.<profile>（如 .env.dev、.env.prod）后填入真实值
#
# 加载规则（DotenvEnvironmentPostProcessor）：
#   1. 先加载同目录的 .env（可选，作为公共默认值）
#   2. 再加载 .env.<profile>，profile 取自 spring.profiles.active（取不到时默认 dev）
#   3. 查找位置：当前工作目录、当前工作目录下的 config/；后者覆盖前者
#   4. 也可以用 -Ddotenv.files=a.env,b.env 指定具体文件，用 -Ddotenv.enabled=false 关闭
#
# 语法：
#   KEY=VALUE             不带引号时原样取值，不做转义（Windows 路径可直接写 D:\files\img）
#   KEY="VALUE"           双引号内支持 \n \r \t \" \\ \$ 转义，并展开 ${VAR}
#   KEY='VALUE'           单引号内完全原样，不转义、不展开
#   export KEY=VALUE      兼容 shell 风格写法
#   # 注释                行首注释，或不带引号值中「空白 + #」之后的部分
#   ${VAR} ${VAR:-默认}   引用其它变量（先查已解析的键，再查系统环境变量）
#
# 说明：这些键只被 application.yml 中的 ${...} 引用；同名系统环境变量 / 命令行参数
# 优先级更高，可以在启动时临时覆盖。

# ---------- 数据目录 ----------
BOT_FILE_LOCATION=
BOT_VIDEO_LOCATION=
BOT_JM_IMG_PATH=
BOT_CONFIG_PATH=

# ---------- 数据库 ----------
BOT_DB_FILE=bot.db
# 切换回 mysql 时在 application.yml 中启用，并填写：
# MYSQL_USERNAME=
# MYSQL_PASSWORD=

# ---------- python（jmcomic 脚本） ----------
BOT_PYTHON_PATH=

# ---------- bot ----------
SHIRO_TOKEN=
SHIRO_WS_CLIENT_URL=
SERVER_IP=

# ---------- MCP 客户端（Streamable HTTP） ----------
BOT_MCP_ENABLED=false
BOT_MCP_URL=https://localhost:9900
BOT_MCP_ENDPOINT=/mcp
BOT_MCP_API_KEY=

# ---------- 代理 ----------
BOT_PROXY_HOST=
BOT_PROXY_PORT=
